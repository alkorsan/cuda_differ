[info]
title=Differ 2
desc=Plugin to compare two files and show compare results side by side
type=cudatext-plugin
subdir=cuda_differ2
homepage=https://github.com/badrelmers/cuda_differ2
api=1.0.483


[item1]
section=events
events=on_state~,on_state_ed~,on_caret~,on_change~,on_change_slow~,on_tab_menu,on_close_pre~,on_close~,on_save_pre~,on_exit_pre~

[item2]
section=commands
